%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a86b52515103a44048cbd7497208e4d1, type: 3}
  m_Name: Mission_NightShiftFactoryFire
  m_EditorClassIdentifier: RescueSim.Runtime::RescueSim.Core.MissionDefinition
  missionId: factory-fire-night-shift
  title: 'Night Shift: Factory Fire'
  tagline: A transformer fire and a gas leak have trapped your crew in Hall 1.
  briefing: 'A transformer fire and a gas leak have started in Hall 1. Part of the
    partition wall has collapsed, and three workers are unaccounted for.


    1.
    Cut main power at the breaker on the east wall before you spray the electrical
    fire.

    2. Close the gas shutoff valve: hold GRIP on the valve wheel until
    it is fully shut.

    3. Grab the extinguisher, squeeze TRIGGER and sweep the
    base of the flames.

    4. Pull the fallen debris out of the collapsed passage.

    5.
    Find every survivor, hold GRIP on them to check them, then lead them to the assembly
    point by the entrance.


    Smoke and fumes build up exposure. Raise your left
    wrist to see time, exposure and the checklist.'
  timeLimitSeconds: 480
  exposureRecoveryPerSecond: 0.04
  objectives:
  - id: power
    title: Cut main power
    hint: Throw the main breaker on the east wall.
    required: 1
  - id: gas
    title: Close the gas valve
    hint: Hold grip on the valve wheel.
    required: 1
  - id: fire
    title: Extinguish both fires
    hint: Isolate power first for the electrical fire.
    required: 1
  - id: route
    title: Clear the collapsed passage
    hint: Grab debris and move it out of the gap.
    required: 1
  - id: locate
    title: Locate survivors
    hint: Look for the beacons and listen for whistles.
    required: 1
  - id: evacuate
    title: Evacuate everyone
    hint: Lead survivors to the assembly point.
    required: 1
  scoring:
    survivorPoints: 500
    hazardPoints: 300
    timeBonusPoints: 200
    maxExposurePenalty: 150
    mistakePenalty: 25
    maxScore: 1000
